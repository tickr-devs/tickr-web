[Unit]
Description=tickr.bot web (Postgres, Django, Caddy)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=tickrweb
WorkingDirectory=/srv/tickr-web/repo/web/deploy
EnvironmentFile=/srv/tickr-web/etc/compose.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
