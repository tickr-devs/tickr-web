#: tickrweb/templates/cabinet/people.html:6
msgid ""
"Everyone with an account. Admins see Early access and People and can change "
"roles; they open these sections only when signed in with a passkey or an "
"authenticator app."
msgstr ""
"Todas las personas con cuenta. Los administradores ven Acceso anticipado y "
"Personas y pueden cambiar roles; abren estas secciones solo con una sesión "
"iniciada con una llave de acceso o una app de autenticación."

#
#: tickrweb/templates/cabinet/people.html:8
msgid "Last sign-in"
msgstr "Último inicio de sesión"

#: tickrweb/templates/cabinet/people.html:11
msgid "you"
msgstr "tú"

#: tickrweb/templates/cabinet/people.html:14
msgid "Never"
msgstr "Nunca"

#: tickrweb/templates/cabinet/people.html:16 tickrweb/views.py:159
msgid "tickr.bot needs at least one admin."
msgstr "tickr.bot necesita al menos un administrador."

#: tickrweb/templates/cabinet/people.html:16
msgid "Remove admin"
msgstr "Quitar administrador"

#: tickrweb/templates/cabinet/people.html:17
msgid "Make admin"
msgstr "Hacer administrador"

#
#: tickrweb/templates/cabinet/people.html:18
msgid "Can be made admin after adding a passkey or an authenticator app"
msgstr ""
"Podrá ser administrador después de añadir una llave de acceso o una app de "
"autenticación"

#: tickrweb/templates/invites/body.txt:1
#: tickrweb/templates/waitlist/confirm_body.txt:1
msgid "Hi,"
msgstr "Hola:"

#: tickrweb/templates/invites/body.txt:3
msgid ""
"You're invited to tickr.bot. Sign in with this email address; we'll send you "
"a one-time code:"
msgstr ""
"Te invitamos a tickr.bot. Inicia sesión con esta dirección de correo; te "
"enviaremos un código de un solo uso:"

#: tickrweb/templates/invites/body.txt:7
msgid ""
"After you sign in, add a passkey under Account so next time it takes one tap."
msgstr ""
"Después de iniciar sesión, añade una llave de acceso en Cuenta para que la "
"próxima vez baste un toque."

#
#: tickrweb/templates/invites/subject.txt:1
msgid "Your tickr.bot account is ready"
msgstr "Tu cuenta de tickr.bot está lista"

#: tickrweb/templates/mfa/index.html:9
msgid ""
"Sign in with Face ID, Touch ID or your device's lock. Needed for the admin "
"sections."
msgstr ""
"Inicia sesión con Face ID, Touch ID o el bloqueo de tu dispositivo. "
"Necesaria para las secciones de administración."

#
#: tickrweb/templates/mfa/index.html:11
msgid "Your passkeys"
msgstr "Tus llaves de acceso"

#: tickrweb/templates/mfa/index.html:12
msgid "Add a passkey"
msgstr "Añadir una llave de acceso"

#: tickrweb/templates/mfa/index.html:16
msgid "Not set: you sign in with a passkey or an emailed code"
msgstr ""
"Sin configurar: inicias sesión con una llave de acceso o un código por correo"

#
#: tickrweb/templates/mfa/index.html:17
msgid "Change password"
msgstr "Cambiar contraseña"

#
#: tickrweb/templates/mfa/index.html:17
msgid "Set a password"
msgstr "Crear una contraseña"

#: tickrweb/templates/mfa/index.html:23
msgid "Turn off"
msgstr "Desactivar"

#: tickrweb/templates/mfa/index.html:23
msgid "Set up"
msgstr "Configurar"

#: tickrweb/templates/mfa/index.html:29
msgid "Recovery codes"
msgstr "Códigos de recuperación"

#
#: tickrweb/templates/mfa/index.html:30
msgid "One-time codes for when you lose your passkey and authenticator app."
msgstr ""
"Códigos de un solo uso por si pierdes tu llave de acceso y tu app de "
"autenticación."

#: tickrweb/templates/mfa/index.html:31
msgid "View codes"
msgstr "Ver códigos"

#: tickrweb/templates/mfa/index.html:32
msgid "Make new codes"
msgstr "Generar códigos nuevos"

#: tickrweb/templates/waitlist/confirm_body.txt:3
msgid ""
"Someone, hopefully you, asked to join the tickr.bot early-access list with "
"this address. Confirm it here:"
msgstr ""
"Alguien, esperamos que tú, pidió unirse a la lista de acceso anticipado de "
"tickr.bot con esta dirección. Confírmala aquí:"

#: tickrweb/templates/waitlist/confirm_body.txt:7
msgid ""
"If it wasn't you, ignore this email and the address is deleted in 7 days. To "
"remove it now:"
msgstr ""
"Si no fuiste tú, ignora este correo y la dirección se eliminará en 7 días. "
"Para eliminarla ahora:"

#: tickrweb/templates/waitlist/confirm_subject.txt:1
msgid "Confirm your place on the tickr.bot list"
msgstr "Confirma tu lugar en la lista de tickr.bot"

#: tickrweb/templates/waitlist/result.html:8
msgid "Confirm your address"
msgstr "Confirma tu dirección"

#: tickrweb/templates/waitlist/result.html:9
msgid "One tap and you're on the tickr.bot early-access list."
msgstr "Un toque y estarás en la lista de acceso anticipado de tickr.bot."

#: tickrweb/templates/waitlist/result.html:10
msgid "Confirm"
msgstr "Confirmar"

#: tickrweb/templates/waitlist/result.html:12
msgid "You're on the list"
msgstr "Ya estás en la lista"

#: tickrweb/templates/waitlist/result.html:13
msgid ""
"We'll email you when tickr.bot opens. Every email has a link to leave the "
"list."
msgstr ""
"Te escribiremos cuando abra tickr.bot. Cada correo incluye un enlace para "
"salir de la lista."

#: tickrweb/templates/waitlist/result.html:15
msgid "Leave the list?"
msgstr "¿Salir de la lista?"

#: tickrweb/templates/waitlist/result.html:16
msgid "Your address will be deleted from the tickr.bot list."
msgstr "Tu dirección se eliminará de la lista de tickr.bot."

#: tickrweb/templates/waitlist/result.html:17
msgid "Delete my address"
msgstr "Eliminar mi dirección"

#: tickrweb/templates/waitlist/result.html:19
msgid "Address deleted"
msgstr "Dirección eliminada"

#: tickrweb/templates/waitlist/result.html:20
msgid "You won't get any more email from tickr.bot."
msgstr "No recibirás más correos de tickr.bot."

#: tickrweb/templates/waitlist/result.html:22
msgid "This link has expired"
msgstr "Este enlace ha caducado"

#: tickrweb/templates/waitlist/result.html:23
msgid "Sign up again on the early-access page to get a new one."
msgstr ""
"Regístrate de nuevo en la página de acceso anticipado para recibir uno nuevo."

#: tickrweb/views.py:100
#, python-format
msgid "Invited %d person."
msgid_plural "Invited %d people."
msgstr[0] "Se invitó a %d persona."
msgstr[1] "Se invitó a %d personas."
msgstr[2] "Se invitó a %d personas."

#: tickrweb/views.py:164
#, python-format
msgid ""
"%(email)s needs a passkey or an authenticator app before becoming an admin."
msgstr ""
"%(email)s necesita una llave de acceso o una app de autenticación antes de "
"ser administrador."

#: tickrweb/views.py:169
msgid "The role changed, but the notice email could not be sent."
msgstr "El rol cambió, pero no se pudo enviar el correo de aviso."

#: tickrweb/views.py:172
#, python-format
msgid "%(email)s is now an admin."
msgstr "%(email)s ahora es administrador."

#: tickrweb/views.py:172
#, python-format
msgid "%(email)s is no longer an admin."
msgstr "%(email)s ya no es administrador."
