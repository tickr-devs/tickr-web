msgstr "Invitar seleccionados"

#: tickrweb/templates/cabinet/early_access.html:23
msgid "Nobody yet"
msgstr "Nadie todavía"

#: tickrweb/templates/cabinet/early_access.html:23
msgid "Addresses from the early-access form on the site show here."
msgstr ""
"Aquí aparecen las direcciones del formulario de acceso anticipado del sitio."

#: tickrweb/templates/cabinet/index.html:7
msgid "Bot"
msgstr "Bot"

#
#: tickrweb/templates/cabinet/index.html:8
msgid "Not connected yet"
msgstr "Aún no conectado"

#: tickrweb/templates/cabinet/index.html:8
msgid ""
"Your bot's status, open positions and today's result will show here once it "
"reports to tickr.bot."
msgstr ""
"El estado de tu bot, las posiciones abiertas y el resultado de hoy "
"aparecerán aquí cuando el bot empiece a informar a tickr.bot."

